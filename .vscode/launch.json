{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Fortran (python testing.py)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/ie4005/anaconda3/bin/python3",
            "args": ["${workspaceFolder}/testing.py"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build-fortran",
            "setupCommands": [
                {
                    "description": "Allow breakpoints in the extension before it is imported",
                    "text": "-gdb-set breakpoint pending on",
                    "ignoreFailures": true
                },
                {
                    "description": "Show large arrays such as g_int",
                    "text": "-gdb-set max-value-size unlimited",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
